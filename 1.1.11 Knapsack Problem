#include <stdio.h>
#include <stdlib.h>

// Utility function to find the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int *values = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &values[i]);
    }

    int *weights = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &weights[i]);
    }

    int W;
    scanf("%d", &W);

    // Create a 1D DP array initialized to 0, where dp[w] stores the max value for capacity w
    int *dp = (int *)calloc(W + 1, sizeof(int));

    // Fill the DP table using the 0/1 knapsack state transition
    for (int i = 0; i < n; i++) {
        for (int w = W; w >= weights[i]; w--) {
            dp[w] = max(dp[w], dp[w - weights[i]] + values[i]);
        }
    }

    // The maximum value for the given capacity W
    printf("%d\n", dp[W]);

    // Free dynamically allocated memory
    free(values);
    free(weights);
    free(dp);

    return 0;
}
